# Environment Variables for Customer Support AI Pipeline
# By default, the system runs with 100% offline deterministic grounded generation and evaluation.
# To optionally enable live cloud LLM APIs, provide one of the following keys:

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Flag to enable live LLM API calls instead of local grounded synthesis:
USE_LIVE_LLM_API=false

# Cache and model settings
HF_HUB_DISABLE_SYMLINKS_WARNING=1
